//MTF Search
public boolean search(int se){
        if(start==null) return false;
        if(start.data==se) return true;
        Node prev=start;
        Node curr=start.next;
        
        while(curr!=null){
            if(curr.data==se){
                prev.next=curr.next;
                curr.next=start;
                start=curr;
                
                
                return true;
            }
            prev=curr;
            curr=curr.next;
        }
        return false;
    }

public int max(){
        Node tptr=start;
        int max=start.data;
        while(tptr!=null){
            if(max<tptr.data)
            max=tptr.data;
            tptr=tptr.next;
        }
        return max;
    }
